{
    "name": "kariricode/processor-pipeline",
    "description": "Immutable, observable processor pipelines for the KaririCode Framework (ARFA 1.3): context-namespaced registry, fail-closed builder, per-stage metrics, chained errors and resilience decorators over kariricode/contract ports.",
    "keywords": [
        "php",
        "pipeline",
        "processor",
        "framework",
        "processor-architecture",
        "kariri-code",
        "arfa",
        "immutable",
        "resilience",
        "php84"
    ],
    "homepage": "https://kariricode.org",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Walmir Silva",
            "email": "walmir.silva@kariricode.org"
        }
    ],
    "support": {
        "issues": "https://github.com/KaririCode-Framework/kariricode-processor-pipeline/issues",
        "source": "https://github.com/KaririCode-Framework/kariricode-processor-pipeline"
    },
    "require": {
        "php": "^8.4",
        "kariricode/contract": "^2.11"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "infection/infection": "^0.29",
        "nikic/php-parser": "^5.4",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "vimeo/psalm": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "KaririCode\\ProcessorPipeline\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KaririCode\\ProcessorPipeline\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Documentation/prelude.php"
        ]
    },
    "scripts": {
        "test": "phpunit --testsuite=unit,integration,documentation",
        "test-conformance": "phpunit --testsuite=conformance",
        "phpstan": "phpstan analyse --no-progress --memory-limit=1G",
        "psalm": "psalm --no-cache --no-progress",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "complexity": [
            "php tools/complexity.php",
            "phpstan analyse -c phpstan-complexity.neon --no-progress --memory-limit=1G"
        ],
        "infection": "infection --threads=max --show-mutations",
        "security": [
            "php tools/secret-scan.php",
            "@composer audit --locked",
            "phpunit --group=fail-closed"
        ],
        "sbom": "php tools/sbom.php sbom.cdx.json",
        "check": [
            "@cs-check",
            "@phpstan",
            "@psalm",
            "@complexity",
            "@test",
            "@test-conformance",
            "@security"
        ]
    },
    "extra": {
        "kariricode": {
            "arfa": {
                "version": "1.3",
                "level": 1
            },
            "asvs": {
                "version": "5.0",
                "level": 2
            },
            "spec": "4.3.3"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
